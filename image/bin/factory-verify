#!/usr/bin/env bash
# Führt die Pflicht-Checks aus .factory/setup.json auf dem aktuellen Commit aus
# und schreibt das Ergebnis nach /work/verify.json und /work/verify.md.
# Der Runner akzeptiert einen Bau nur, wenn verify.json grün ist und zum gepushten Commit passt.
#
#   factory-verify            (im Repo-Ordner aufrufen, ohne uncommittete Änderungen)
set -uo pipefail

WORKDIR="${FACTORY_WORK:-/work}"
cd "${1:-$WORKDIR/repo}"
# Alte Ergebnisse löschen: ein Abbruch darf nie ein früheres "grün" stehen lassen.
rm -f "$WORKDIR/verify.json" "$WORKDIR/verify.md"
if [ -n "$(git status --porcelain)" ]; then
  echo "Es gibt uncommittete Änderungen. Erst committen und pushen, dann prüfen." >&2
  exit 2
fi
if [ ! -f .factory/setup.json ]; then
  echo "Keine .factory/setup.json gefunden. Lege sie an (install + checks) und committe sie." >&2
  exit 2
fi

# Prüfvorgaben streng lesen: gültiges JSON und mindestens ein Check, sonst ist nichts geprüft.
# Erlaubt zwei Formen: {"name": "befehl"} (kanonisch) und ["befehl", ...] (wird benannt).
if ! CHECKS=$(jq -er '
      .checks
      | if type == "object" then
          to_entries | map(select((.value | type) == "string" and (.value | length) > 0)) | map([.key, .value])
        elif type == "array" then
          to_entries | map(select((.value | type) == "string" and (.value | length) > 0)) | map([("check_" + ((.key + 1) | tostring)), .value])
        else empty end
      | select(length > 0) | .[] | @tsv' .factory/setup.json 2>/dev/null); then
  echo ".factory/setup.json ist ungültig oder enthält keine Checks (\"checks\": {\"name\": \"befehl\"}). Ohne Checks gilt nichts als geprüft." >&2
  exit 2
fi

# Ist der Branch auf dem Stand von main? Ein PR, der hinter main liegt, kann Funktionen
# stillschweigend entfernen, die inzwischen gemergt wurden. Das wird hier festgehalten und
# vom Runner abgelehnt.
UP_TO_DATE=true
if git rev-parse --verify -q origin/main >/dev/null 2>&1; then
  git fetch -q origin main >/dev/null 2>&1 || true
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ] && ! git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
    UP_TO_DATE=false
    echo "⚠ Dieser Branch enthält main nicht. Vor dem Review: git fetch origin && git merge origin/main" >&2
  fi
fi

# Pflichtprüfungen dürfen nicht verschwinden. Diese Regel liegt bewusst hier im Image und
# nicht im Repo: ein Lauf, der seine eigenen Prüfungen entfernt, kann sie so nicht abschalten.
# Verglichen wird mit der Fassung auf main — dort steht, was verbindlich ist.
if git rev-parse --verify -q origin/main >/dev/null 2>&1 && git cat-file -e origin/main:.factory/setup.json 2>/dev/null; then
  base_cmds=$(git show origin/main:.factory/setup.json \
    | jq -r '.checks | if type == "object" then .[] elif type == "array" then .[] else empty end' 2>/dev/null \
    | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' | sort -u)
  now_cmds=$(jq -r '.checks | if type == "object" then .[] elif type == "array" then .[] else empty end' .factory/setup.json 2>/dev/null \
    | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' | sort -u)
  if [ -n "${base_cmds:-}" ]; then
    removed=$(comm -23 <(printf '%s\n' "$base_cmds") <(printf '%s\n' "$now_cmds"))
    if [ -n "$removed" ]; then
      {
        echo "Pflichtprüfungen aus main fehlen in diesem Branch:"
        printf '%s\n' "$removed" | sed 's/^/  - /'
        echo
        echo "Prüfungen werden nicht entfernt, sondern erfüllt. Wenn eine Prüfung in dieser"
        echo "Umgebung nicht laufen kann, gehört das in den Bericht — nicht aus der Liste."
      } >&2
      exit 3
    fi
  fi
fi

SHA=$(git rev-parse HEAD)
RESULTS="[]"; FAILED=0
MD="| Check | Befehl | Ergebnis |\n|---|---|---|\n"
while IFS=$'\t' read -r NAME CMD; do
  [ -z "$NAME" ] && continue
  echo "▶ $NAME: $CMD"
  OUT=$(bash -lc "$CMD" </dev/null 2>&1); CODE=$?
  TAIL=$(printf "%s" "$OUT" | tail -n 25)
  if [ $CODE -eq 0 ]; then echo "  ✓ bestanden"; ICON="✅"; else echo "  ✗ fehlgeschlagen (Exit $CODE)"; printf "%s\n" "$TAIL"; ICON="❌ Exit $CODE"; FAILED=1; fi
  MD+="| $NAME | \`$CMD\` | $ICON |\n"
  RESULTS=$(jq --arg n "$NAME" --arg c "$CMD" --argjson e $CODE --arg t "$TAIL" '. + [{name:$n, cmd:$c, exit:$e, tail:$t}]' <<<"$RESULTS")
done <<< "$CHECKS"

jq -n --arg sha "$SHA" --argjson r "$RESULTS" --argjson ok $([ $FAILED -eq 0 ] && echo true || echo false) --argjson uptodate "$UP_TO_DATE" \
  '{sha:$sha, ok:$ok, upToDate:$uptodate, results:$r, at:(now|todate)}' > "$WORKDIR/verify.json"
printf "**Checks auf Commit \`%s\`**\n\n$MD" "${SHA:0:7}" > "$WORKDIR/verify.md"
[ "$UP_TO_DATE" = false ] && printf "\n⚠️ Branch enthält \`main\` nicht — vor dem Review mergen.\n" >> "$WORKDIR/verify.md"
echo; [ $FAILED -eq 0 ] && echo "Alle Checks bestanden auf ${SHA:0:7}." || echo "Mindestens ein Check ist fehlgeschlagen."
exit $FAILED
